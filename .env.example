# === Configuration ShopVite FAQ Assistant ===

# Clé API OpenAI (obligatoire)
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX (private, ne pas partager)

# Modèle LLM utilisé pour la génération
LLM_MODEL=gpt-4o-mini

# Modèle d'embedding pour la vectorisation
EMBEDDING_MODEL=text-embedding-3-small

# Paramètres de chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Nombre de chunks retournés par le retriever
TOP_K=4

# Configuration serveur
API_HOST=0.0.0.0
API_PORT=8000
